{{!
    @template local_aitutor/main

    Main layout of the AI Tutor page of ONE course (every course has its own tutor). The conversation itself is rendered by the AMD module local_aitutor/app.

    Example context (json):
    {
        "courseid": 2,
        "coursename": "Software Engineering II",
        "avatar": "http://example.com/tutor.svg",
        "courseurl": "http://example.com/course/view.php?id=2",
        "username": "Student One",
        "initials": "SO",
        "courseshort": "SE2",
        "modes": [
            {"mode": "chat", "label": "New Chat", "icon": "i/new"},
            {"mode": "quiz", "label": "Practice Quiz", "icon": "i/questions"}
        ]
    }
}}
<div class="aitutor aitutor-gpt" id="aitutor-root" data-region="aitutor">
    <aside class="aitutor-sidebar" data-region="sidebar" aria-label="{{#str}}pluginname, local_aitutor{{/str}}">
        <div class="aitutor-sidebar-top">
            <div class="aitutor-brand">
                <span class="aitutor-brand-name">{{#str}}pluginname, local_aitutor{{/str}}</span>
            </div>
            <div class="aitutor-sidebar-tools">
                <button type="button" class="aitutor-iconbtn" data-action="search" aria-expanded="false"
                        title="{{#str}}search, local_aitutor{{/str}}" aria-label="{{#str}}search, local_aitutor{{/str}}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></button>
                <button type="button" class="aitutor-iconbtn" data-action="toggle-sidebar" aria-expanded="true"
                        title="{{#str}}togglesidebar, local_aitutor{{/str}}" aria-label="{{#str}}togglesidebar, local_aitutor{{/str}}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg></button>
            </div>
        </div>
        <button type="button" class="aitutor-newchat aitutor-nav-item" data-action="nav" data-mode="chat">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
            <span>{{#str}}newchat, local_aitutor{{/str}}</span>
        </button>
        <div class="aitutor-search" data-region="search" hidden>
            <input type="search" class="aitutor-search-input" data-region="search-input"
                   placeholder="{{#str}}searchplaceholder, local_aitutor{{/str}}"
                   aria-label="{{#str}}search, local_aitutor{{/str}}">
        </div>
        <div class="aitutor-sidebar-section">
            <div class="aitutor-sidebar-heading">{{#str}}recents, local_aitutor{{/str}}</div>
            <ul class="aitutor-recent list-unstyled mb-0" data-region="recent-chats"></ul>
        </div>
    </aside>

    <section class="aitutor-main" aria-label="{{#str}}conversation, local_aitutor{{/str}}">
        <header class="aitutor-main-header">
            <button type="button" class="aitutor-iconbtn aitutor-sidebar-open" data-action="toggle-sidebar" aria-expanded="true"
                    title="{{#str}}togglesidebar, local_aitutor{{/str}}" aria-label="{{#str}}togglesidebar, local_aitutor{{/str}}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg></button>
            <h2 class="aitutor-chat-title" data-region="chat-title">{{#str}}newchat, local_aitutor{{/str}}</h2>
            <span class="aitutor-hintlabel" data-region="hint-label" hidden>{{#str}}hintmode, local_aitutor{{/str}}</span>
            <span class="aitutor-course-pill" data-region="course-name">{{coursename}}</span>
        </header>

        <div class="aitutor-stage" data-region="stage">
            <div class="aitutor-messages" data-region="messages" role="log" aria-live="polite" tabindex="0"></div>

            <div class="aitutor-composer-wrap" data-region="composer-wrap">
                <h1 class="aitutor-hero" data-region="hero">{{#str}}welcomehero, local_aitutor{{/str}}</h1>
                <form class="aitutor-composer" data-region="composer" autocomplete="off">
                    {{! Tools menu: Hint mode, course context and quick actions. The dot shows Hint mode is on. }}
                    <div class="aitutor-tools-wrap">
                        <button type="button" class="aitutor-toolsbtn" data-action="toggle-context" aria-expanded="false"
                                aria-haspopup="true" aria-controls="aitutor-context-body"
                                title="{{#str}}tools, local_aitutor{{/str}}" aria-label="{{#str}}tools, local_aitutor{{/str}}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg><span class="aitutor-toolsbtn-label" aria-hidden="true">{{#str}}tools, local_aitutor{{/str}}</span><span class="aitutor-toolsbtn-dot" aria-hidden="true"></span></button>
                        <div id="aitutor-context-body" class="aitutor-popover" data-region="context-body" hidden>
                            <div class="form-check form-switch aitutor-hinttoggle">
                                <label class="form-check-label" for="aitutor-hintmode">{{#str}}hintmode, local_aitutor{{/str}}</label>
                                <input type="checkbox" role="switch" class="form-check-input" id="aitutor-hintmode" data-region="hint-toggle">
                            </div>
                            <div class="aitutor-popover-sep"></div>
                            <div class="aitutor-label">{{#str}}selectedresource, local_aitutor{{/str}}</div>
                            <div class="aitutor-resource-row">
                                {{#pix}}i/files, core, {{/pix}}
                                <span class="aitutor-resource-name" data-region="resource-name">{{#str}}noresource_selected, local_aitutor{{/str}}</span>
                                <button type="button" class="aitutor-link" data-action="change-resource">{{#str}}change, local_aitutor{{/str}}</button>
                            </div>
                            <label for="aitutor-resource" class="sr-only">{{#str}}selectedresource, local_aitutor{{/str}}</label>
                            <select id="aitutor-resource" class="custom-select form-control-sm mt-2" data-region="resource-select" hidden>
                                <option value="0">{{#str}}noresource_selected, local_aitutor{{/str}}</option>
                            </select>
                            <div class="aitutor-usecontext">
                                <div class="form-check mb-0">
                                    <input type="checkbox" class="form-check-input" id="aitutor-useresource" data-region="use-resource" checked>
                                    <label class="form-check-label" for="aitutor-useresource">{{#str}}usecontext, local_aitutor{{/str}}</label>
                                </div>
                                <span class="aitutor-info" title="{{#str}}usecontext_info, local_aitutor{{/str}}" tabindex="0"
                                      aria-label="{{#str}}usecontext_info, local_aitutor{{/str}}">{{#pix}}i/info, core, {{/pix}}</span>
                            </div>
                            <div class="aitutor-hint small">{{#str}}usecontext_hint, local_aitutor{{/str}}</div>
                            <div class="aitutor-popover-sep"></div>
                            <div class="aitutor-label">{{#str}}quickactions, local_aitutor{{/str}}</div>
                            <div class="aitutor-quick">
                                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="context">{{#pix}}i/files, core, {{/pix}}<span>{{#str}}qa_usecontext, local_aitutor{{/str}}</span></button>
                                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="summary">{{#pix}}i/report, core, {{/pix}}<span>{{#str}}qa_summarize, local_aitutor{{/str}}</span></button>
                                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="flashcards">{{#pix}}i/new, core, {{/pix}}<span>{{#str}}qa_flashcards, local_aitutor{{/str}}</span></button>
                                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="quiz">{{#pix}}i/questions, core, {{/pix}}<span>{{#str}}qa_mcqs, local_aitutor{{/str}}</span></button>
                                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="studyplan">{{#pix}}i/calendar, core, {{/pix}}<span>{{#str}}nav_studyplan, local_aitutor{{/str}}</span></button>
                            </div>
                        </div>
                    </div>
                    <label for="aitutor-input" class="sr-only">{{#str}}askplaceholder, local_aitutor{{/str}}</label>
                    <textarea id="aitutor-input" class="aitutor-input" data-region="input" rows="1"
                              maxlength="2000" placeholder="{{#str}}askplaceholder, local_aitutor{{/str}}"></textarea>
                    <button type="button" class="aitutor-micbtn" data-action="dictate" aria-pressed="false"
                            title="{{#str}}dictate, local_aitutor{{/str}}" aria-label="{{#str}}dictate, local_aitutor{{/str}}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg></button>
                    <button type="submit" class="aitutor-send" data-action="send" data-state="voice"
                            title="{{#str}}voicesend, local_aitutor{{/str}}" aria-label="{{#str}}voicesend, local_aitutor{{/str}}">
                        <span class="aitutor-ico aitutor-ico-voice"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 10v3"/><path d="M6 6v11"/><path d="M10 3v18"/><path d="M14 8v7"/><path d="M18 5v13"/><path d="M22 10v3"/></svg></span>
                        <span class="aitutor-ico aitutor-ico-send"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></span>
                        <span class="aitutor-ico aitutor-ico-stop"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><rect x="5" y="5" width="14" height="14" rx="3"/></svg></span>
                    </button>
                </form>
                <div class="aitutor-voice-note" data-region="voice-note" role="status" hidden></div>
                <div class="aitutor-disclaimer">{{#str}}gptdisclaimer, local_aitutor{{/str}}</div>
            </div>
        </div>
    </section>
</div>

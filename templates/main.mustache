{{!
    @template local_aitutor/main

    Main layout of the AI Tutor page of ONE course (every course has its own tutor). The conversation itself is rendered by the AMD module local_aitutor/app.

    Example context (json):
    {
        "courseid": 2,
        "coursename": "Software Engineering II",
        "avatar": "http://example.com/tutor.svg",
        "modes": [
            {"mode": "chat", "label": "New Chat", "icon": "i/new"},
            {"mode": "quiz", "label": "Practice Quiz", "icon": "i/questions"}
        ]
    }
}}
<div class="aitutor" id="aitutor-root" data-region="aitutor">
    <nav class="aitutor-sidebar card" aria-label="{{#str}}pluginname, local_aitutor{{/str}}">
        <div class="aitutor-brand">
            <img src="{{avatar}}" alt="" class="aitutor-brand-avatar" width="36" height="36">
            <span class="aitutor-brand-name">{{#str}}pluginname, local_aitutor{{/str}}</span>
        </div>
        <ul class="aitutor-nav list-unstyled mb-0">
            {{#modes}}
            <li>
                <button type="button" class="aitutor-nav-item" data-action="nav" data-mode="{{mode}}">
                    {{#pix}}{{icon}}, core, {{/pix}}
                    <span>{{label}}</span>
                </button>
            </li>
            {{/modes}}
        </ul>
    </nav>

    <section class="aitutor-main card" aria-label="{{#str}}conversation, local_aitutor{{/str}}">
        <header class="aitutor-main-header">
            <h2 class="aitutor-chat-title h6 mb-0" data-region="chat-title">{{#str}}newchat, local_aitutor{{/str}}</h2>
        </header>
        <div class="aitutor-messages" data-region="messages" role="log" aria-live="polite" tabindex="0"></div>
        <form class="aitutor-composer" data-region="composer" autocomplete="off">
            <label for="aitutor-input" class="sr-only">{{#str}}askplaceholder, local_aitutor{{/str}}</label>
            <input type="text" id="aitutor-input" class="form-control aitutor-input" data-region="input"
                   maxlength="2000" placeholder="{{#str}}askplaceholder, local_aitutor{{/str}}">
            <button type="submit" class="aitutor-send" data-action="send" title="{{#str}}send, local_aitutor{{/str}}">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M2.5 20.5 22 12 2.5 3.5l.01 6.5L16 12 2.51 14z"/></svg>
            </button>
        </form>
    </section>

    <aside class="aitutor-side card-stack">
        <div class="card aitutor-panel" data-region="context-card">
            <button type="button" class="aitutor-panel-toggle" data-action="toggle-context" aria-expanded="true"
                    aria-controls="aitutor-context-body">
                <span class="aitutor-panel-title">{{#pix}}i/course, core, {{/pix}} {{#str}}coursecontext, local_aitutor{{/str}}</span>
                <span class="aitutor-chevron" aria-hidden="true"></span>
            </button>
            <div id="aitutor-context-body" data-region="context-body">
                <div class="aitutor-coursename" data-region="course-name">{{coursename}}</div>
                <div class="aitutor-label">{{#str}}selectedresource, local_aitutor{{/str}}</div>
                <div class="aitutor-resource-row">
                    {{#pix}}i/files, core, {{/pix}}
                    <span class="aitutor-resource-name" data-region="resource-name">{{#str}}noresource_selected, local_aitutor{{/str}}</span>
                    <button type="button" class="aitutor-link" data-action="change-resource">{{#str}}change, local_aitutor{{/str}}</button>
                </div>
                <label for="aitutor-resource" class="sr-only">{{#str}}selectedresource, local_aitutor{{/str}}</label>
                <select id="aitutor-resource" class="custom-select form-control-sm mt-2" data-region="resource-select" hidden>
                    <option value="0">{{#str}}noresource_selected, local_aitutor{{/str}}</option>
                </select>
                <div class="aitutor-usecontext">
                    <div class="form-check mb-0">
                        <input type="checkbox" class="form-check-input" id="aitutor-useresource" data-region="use-resource" checked>
                        <label class="form-check-label" for="aitutor-useresource">{{#str}}usecontext, local_aitutor{{/str}}</label>
                    </div>
                    <span class="aitutor-info" title="{{#str}}usecontext_info, local_aitutor{{/str}}" tabindex="0"
                          aria-label="{{#str}}usecontext_info, local_aitutor{{/str}}">{{#pix}}i/info, core, {{/pix}}</span>
                </div>
                <div class="aitutor-hint small">{{#str}}usecontext_hint, local_aitutor{{/str}}</div>
            </div>
        </div>

        <div class="card aitutor-panel">
            <h3 class="aitutor-panel-title">{{#pix}}i/new, core, {{/pix}} {{#str}}quickactions, local_aitutor{{/str}}</h3>
            <div class="aitutor-quick">
                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="context">{{#pix}}i/files, core, {{/pix}}<span>{{#str}}qa_usecontext, local_aitutor{{/str}}</span></button>
                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="summary">{{#pix}}i/report, core, {{/pix}}<span>{{#str}}qa_summarize, local_aitutor{{/str}}</span></button>
                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="flashcards">{{#pix}}i/new, core, {{/pix}}<span>{{#str}}qa_flashcards, local_aitutor{{/str}}</span></button>
                <button type="button" class="aitutor-quick-btn" data-action="quick" data-mode="quiz">{{#pix}}i/questions, core, {{/pix}}<span>{{#str}}qa_mcqs, local_aitutor{{/str}}</span></button>
            </div>
        </div>

        <div class="card aitutor-panel">
            <div class="aitutor-panel-head">
                <h3 class="aitutor-panel-title mb-0">{{#pix}}i/log, core, {{/pix}} {{#str}}recentchats, local_aitutor{{/str}}</h3>
                <button type="button" class="aitutor-link" data-action="viewall">{{#str}}viewall, local_aitutor{{/str}}</button>
            </div>
            <ul class="aitutor-recent list-unstyled mb-0" data-region="recent-chats"></ul>
        </div>
    </aside>
</div>
